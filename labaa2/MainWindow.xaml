<Window x:Class="labaa2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:labaa2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>

        <SolidColorBrush x:Key="BloodRed" Color="#8B0000"/>
        <SolidColorBrush x:Key="DarkRed" Color="#5A0000"/>
        <SolidColorBrush x:Key="PanelBg" Color="#141414"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#3A0000"/>
        <SolidColorBrush x:Key="TextMain" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="TextDim" Color="#7A7A7A"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- Кнопки -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BloodRed}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A0000"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF2020"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8B0000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BloodRed}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Полоса здоровья: цвет задаётся из кода (FINE / CAUTION / DANGER) -->
        <Style x:Key="ReBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#0F0F0F"
                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" Margin="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: игрок -->
        <Border Grid.Column="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
            Padding="10" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="PLAYER" Style="{StaticResource HeaderStyle}"/>

                <TextBlock Text="Gold"/>
                <TextBlock x:Name="GoldText" FontSize="22" FontWeight="Bold"
                       Foreground="#E0B84A" Margin="0,0,0,10"/>

                <TextBlock Text="Damage"/>
                <TextBlock x:Name="DamageText" FontSize="16" FontWeight="Bold"
                       Foreground="#E0E0E0" Margin="0,0,0,10"/>

                <TextBlock Text="Click cooldown"/>
                <TextBlock x:Name="CooldownText" FontSize="14" FontWeight="Bold"
                       Foreground="#E0E0E0" Margin="0,0,0,10"/>

                <TextBlock x:Name="EffectsText" FontSize="13" FontWeight="Bold"
                       Foreground="#3FBF4F" MinHeight="20"/>

                <Button x:Name="UpgradeButton" Height="44" Margin="0,20,0,0"
                    Click="UpgradeButton_Click"/>

                <Button x:Name="CooldownUpgradeButton" Height="44" Margin="0,10,0,0"
                    Click="CooldownUpgradeButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Центральная панель: цель -->
        <Border Grid.Column="1" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
            Padding="15" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="TARGET" Style="{StaticResource HeaderStyle}"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock x:Name="EnemyNameText" FontSize="22" FontWeight="Bold"
                           Foreground="#E0E0E0" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0"/>
                    <TextBlock x:Name="StatusText" FontSize="13" FontWeight="Bold" MinHeight="20"
                           Foreground="#FF2020" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Портрет: кликабельна только сама иконка -->
                <Border Grid.Row="2" Background="#0F0F0F"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    ClipToBounds="True"
                    PreviewMouseLeftButtonDown="Portrait_PreviewMouseLeftButtonDown">
                    <Grid>
                        <Image x:Name="EnemyImage" Stretch="Uniform" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                           MouseLeftButtonDown="EnemyImage_MouseLeftButtonDown">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PopTransform"/>
                                    <ScaleTransform x:Name="BreathTransform"/>
                                    <RotateTransform x:Name="TiltTransform"/>
                                    <TranslateTransform x:Name="MoveTransform"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Виньетка по краям -->
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#00000000" Offset="0.55"/>
                                    <GradientStop Color="#EE000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Красная вспышка при попадании (анимируется из кода) -->
                        <Rectangle x:Name="HitOverlay" Fill="{StaticResource BloodRed}"
                               Opacity="0" IsHitTestVisible="False"/>

                        <!-- Слой бонусных сфер (клики ловит Border портрета) -->
                        <Canvas x:Name="OrbCanvas" IsHitTestVisible="False"
                                SizeChanged="OrbCanvas_SizeChanged"/>
                    </Grid>
                </Border>

                <ProgressBar x:Name="HealthBar" Grid.Row="3" Style="{StaticResource ReBar}"
                         Minimum="0" Maximum="100" Height="18" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Правая панель: данные противника -->
        <Border Grid.Column="2" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
            Padding="10">
            <StackPanel>
                <TextBlock Text="ENEMY DATA" Style="{StaticResource HeaderStyle}"/>

                <TextBlock Text="Health"/>
                <TextBlock x:Name="HealthText" FontSize="14" Foreground="#E0E0E0"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="Reward"/>
                <TextBlock x:Name="RewardText" FontSize="16" FontWeight="Bold"
                       Foreground="#E0B84A" Margin="0,0,0,10"/>

                <TextBlock Text="Condition"/>
                <TextBlock x:Name="ConditionText" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>